# Python cache and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.env

# Notebook runtime artifacts
.ipynb_checkpoints/

# User-specific financial data must never be committed to the public repository
data/private/*
!data/private/.gitkeep

# Downloaded market data and generated analysis outputs (keep directory placeholders)
data/raw/*.csv
data/raw/*.meta.json
outputs/*
!outputs/.gitkeep

# OS / editor files
.DS_Store
.vscode/
.idea/
